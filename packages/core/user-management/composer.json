{
    "name": "example/laravel-master-core-user-management",
    "description": "Host user account management for Laravel Master Core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "example/laravel-master-core-foundation": "^0.1.0",
        "example/laravel-master-core-auth": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\UserManagement\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\UserManagement\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\UserManagement\\Providers\\UserManagementServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

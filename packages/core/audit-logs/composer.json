{
    "name": "example/laravel-master-core-audit-logs",
    "description": "Append-only security audit history for Laravel Master Core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\AuditLogs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\AuditLogs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\AuditLogs\\Providers\\AuditLogsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

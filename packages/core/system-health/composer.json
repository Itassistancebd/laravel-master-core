{
    "name": "example/laravel-master-core-system-health",
    "description": "Authenticated, read-only system readiness checks for Laravel Master Core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "example/laravel-master-core-foundation": "^0.1.0",
        "example/laravel-master-core-roles-permissions": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\SystemHealth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\SystemHealth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\SystemHealth\\Providers\\SystemHealthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "name": "example/laravel-master-core-foundation",
    "description": "Reusable foundation services for Laravel 12 applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\Foundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\Foundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\Foundation\\Providers\\FoundationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

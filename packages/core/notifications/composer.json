{
    "name": "example/laravel-master-core-notifications",
    "description": "Recipient-scoped in-app notifications for Laravel Master Core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "example/laravel-master-core-foundation": "^0.1.0",
        "example/laravel-master-core-roles-permissions": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\Notifications\\Providers\\NotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "name": "example/laravel-master-core-auth",
    "description": "Authentication and security integration for Laravel Master Core.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "example/laravel-master-core-foundation": "^0.1.0",
        "laravel/fortify": "^1.25",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MasterCore\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MasterCore\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MasterCore\\Auth\\Providers\\AuthenticationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
